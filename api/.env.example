# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (MySQL 8)
DATABASE_URL="mysql://guiajovem:guiajovem@localhost:3306/guiajovem"

# JWT
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Google (RF05): ID do cliente "Aplicativo da Web" do Google Cloud, o mesmo
# valor passado ao app em --dart-define=GOOGLE_CLIENT_ID. Vazio: login com Google recusado.
GOOGLE_CLIENT_ID=

# E-mail (SMTP via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Guia Jovem <nao-responda@guiajovem.com.br>"

# URL do app Flutter, usada em links de e-mail (recuperação de senha, aprovação)
APP_URL=http://localhost:8080

# Administrador inicial (seed)
ADMIN_NOME="Administrador Guia Jovem"
ADMIN_EMAIL=admin@guiajovem.com.br
ADMIN_SENHA=troque-esta-senha
