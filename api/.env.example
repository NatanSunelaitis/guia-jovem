# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (MySQL 8)
DATABASE_URL="mysql://guiajovem:guiajovem@localhost:3306/guiajovem"

# JWT
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Google (RF05): ID do cliente "Aplicativo da Web" do Google Cloud, o mesmo
# valor passado ao app em --dart-define=GOOGLE_CLIENT_ID. Vazio: login com Google recusado.
GOOGLE_CLIENT_ID=

# E-mail (SMTP via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Guia Jovem <nao-responda@guiajovem.com.br>"

# Login e recuperação de senha: tentativas por IP a cada 15 minutos (5.11)
LIMITE_TENTATIVAS_LOGIN=10

# URL do app Flutter, usada em links de e-mail (recuperação de senha, aprovação)
APP_URL=http://localhost:8080

# Origens aceitas pelo CORS, separadas por vírgula (ex.: https://guiajovem.com.br,https://guiajovem.netlify.app).
# Vazio: vale o APP_URL e, fora de produção, também http://localhost:8080 e http://127.0.0.1:8080.
CORS_ORIGENS=

# Administrador inicial (seed)
ADMIN_NOME="Administrador Guia Jovem"
ADMIN_EMAIL=admin@guiajovem.com.br
ADMIN_SENHA=troque-esta-senha

# Dados de demonstração (npm run db:demo): banco que recebe os dados e senha das contas
# DEMO_DATABASE_URL="mysql://root:SUA_SENHA@127.0.0.1:3306/guiajovem_demo"
# DEMO_SENHA=Demo@2026

# Conferência de ponta a ponta (npm run conferencia): banco APAGADO a cada execução,
# com o nome terminado em _teste, _test ou _e2e
# CONFERENCIA_DATABASE_URL="mysql://root:SUA_SENHA@127.0.0.1:3306/guiajovem_teste"

# Backup (npm run backup). Sem as variáveis BACKUP_S3_*, o backup fica só no arquivo local.
# BACKUP_DATABASE_URL=   (padrão: DATABASE_URL)
# BACKUP_DIR=./backups
# BACKUP_RETENCAO_DIAS=7
# MYSQLDUMP_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe"
# BACKUP_S3_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=guiajovem-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGIAO=auto
# BACKUP_S3_PREFIXO=guiajovem/
